__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.dylib

# Rust (maturin / cargo)
rust/c64py-core/target/

# Local reSID source tree (nested clone / autotools build from setup_resid.sh; not part of this repo)
src/resid_wrapper/resid/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
ENV/
env/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# VIC hang matrix raw RAM dumps (see scripts/run_vic_hang_matrix.sh)
vic_matrix_snapshots/

# Emulator-state snapshots (--save-snapshot-at-cycle / at-exit / alt-s).
# These are per-run binaries useful for debugging but not for VCS.
snapshots/

# Ad-hoc render output from scripts/snapshot_render_test.py and similar.
out/

# Accidental root-level ReSID/debug captures (not part of the repo).
/test.wav

# User-provided screenshot media and generated PNGs (see docs/screenshots/local/README.md)
docs/screenshots/local/output/
docs/screenshots/local/manifest.local.json

# find_first_ram_diff_cycle.py RAM + log cache
.c64py_ram_cache/

# Local logs and benchmark NDJSON (see scripts/run_benchmark.sh)
logs/*
*.log

# C64 Copyrighted roms
roms/

# Compiled files
*.prg
*.d64

# External VICE test corpus (downloaded on demand)
test/vice/*
!test/vice/.gitkeep
!test/vice/README.md

# Editors / OS
.DS_Store
.idea/
.vscode/
.aider*
.sentrux/
