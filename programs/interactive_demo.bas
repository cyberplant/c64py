10 REM ********************************
20 REM * INTERACTIVE GRAPHICS DEMO    *
30 REM * BY COPILOT FOR C64PY         *
40 REM ********************************
50 REM
60 PRINT CHR$(147):REM CLEAR SCREEN
70 PRINT "C64 GRAPHICS MODE TESTER"
80 PRINT "========================"
90 PRINT
100 PRINT "THIS DEMO LETS YOU TEST"
110 PRINT "DIFFERENT GRAPHICS FEATURES"
120 PRINT "ONE AT A TIME."
130 PRINT
140 PRINT "PRESS ANY KEY TO START..."
150 GET K$:IF K$="" THEN 150
160 REM
170 REM *** MAIN MENU ***
180 REM
190 PRINT CHR$(147)
200 PRINT "GRAPHICS MODE MENU"
210 PRINT "=================="
220 PRINT
230 PRINT "1. ENABLE BITMAP MODE"
240 PRINT "2. SET SCREEN COLORS"
250 PRINT "3. CLEAR BITMAP"
260 PRINT "4. DRAW BORDER BOX"
270 PRINT "5. DRAW DIAGONAL LINES"
280 PRINT "6. DRAW CHECKERBOARD"
290 PRINT "7. ENABLE SPRITE 0"
300 PRINT "8. ANIMATE SPRITE"
310 PRINT "9. DISABLE BITMAP MODE"
320 PRINT "0. QUIT"
330 PRINT
340 PRINT "CHOICE (0-9)? ";
350 GET K$:IF K$="" THEN 350
360 IF K$<"0" OR K$>"9" THEN 350
370 C=VAL(K$)
380 IF C=0 THEN 2800
390 ON C GOTO 440,630,800,960,1260,1480,1700,2130,2330
400 GOTO 190
410 REM
420 REM *** ENABLE BITMAP MODE ***
430 REM
440 PRINT CHR$(147)
450 PRINT "ENABLING BITMAP MODE..."
460 PRINT
470 REM SET COLORS
480 POKE 53280,0:REM BORDER=BLACK
490 POKE 53281,6:REM BACKGROUND=BLUE
500 REM ENABLE BITMAP MODE (BIT 5 OF $D011)
510 POKE 53265,PEEK(53265) OR 32
520 REM SET BITMAP AT $2000, SCREEN AT $0400
530 REM $D018 = %0001 1000 = $18
540 POKE 53272,24
550 PRINT "BITMAP MODE ENABLED"
560 PRINT "$D011 =";PEEK(53265)
570 PRINT "$D018 =";PEEK(53272)
580 PRINT
590 PRINT "PRESS ANY KEY...";
600 GET K$:IF K$="" THEN 600
610 GOTO 190
620 REM
630 REM *** SET SCREEN COLORS ***
640 REM
650 PRINT CHR$(147)
660 PRINT "SETTING SCREEN COLORS..."
670 REM YELLOW (7) ON BLUE (6) = $76
680 FOR I=1024 TO 2023
690 POKE I,118
700 IF I MOD 200 = 0 THEN PRINT ".";
710 NEXT I
720 PRINT
730 PRINT "DONE!"
740 PRINT "PRESS ANY KEY...";
750 GET K$:IF K$="" THEN 750
760 GOTO 190
770 REM
780 REM *** CLEAR BITMAP ***
790 REM
800 PRINT CHR$(147)
810 PRINT "CLEARING BITMAP..."
820 FOR I=8192 TO 16191 STEP 100
830 FOR J=0 TO 99
840 POKE I+J,0
850 NEXT J
860 PRINT ".";
870 NEXT I
880 PRINT
890 PRINT "DONE!"
900 PRINT "PRESS ANY KEY...";
910 GET K$:IF K$="" THEN 910
920 GOTO 190
930 REM
940 REM *** DRAW BORDER BOX ***
950 REM
960 PRINT CHR$(147)
970 PRINT "DRAWING BORDER BOX..."
980 PRINT
990 REM TOP LINE (FIRST 40 BYTES)
1000 FOR I=0 TO 39
1010 POKE 8192+I,255
1020 NEXT I
1030 PRINT "TOP LINE DRAWN"
1040 REM BOTTOM LINE
1050 FOR I=0 TO 39
1060 POKE 8192+7960+I,255
1070 NEXT I
1080 PRINT "BOTTOM LINE DRAWN"
1090 REM LEFT AND RIGHT EDGES
1100 FOR Y=0 TO 199 STEP 10
1110 FOR YY=0 TO 9
1120 IF Y+YY>199 THEN 1160
1130 POKE 8192+(Y+YY)*40,128:REM LEFT
1140 POKE 8192+(Y+YY)*40+39,1:REM RIGHT
1150 NEXT YY
1160 PRINT ".";
1170 NEXT Y
1180 PRINT
1190 PRINT "BORDER BOX COMPLETE!"
1200 PRINT "PRESS ANY KEY...";
1210 GET K$:IF K$="" THEN 1210
1220 GOTO 190
1230 REM
1240 REM *** DRAW DIAGONAL LINES ***
1250 REM
1260 PRINT CHR$(147)
1270 PRINT "DRAWING DIAGONALS..."
1280 PRINT
1290 REM DIAGONAL 1
1300 FOR I=0 TO 100 STEP 5
1310 FOR II=0 TO 4
1320 X=(I+II)*2:Y=I+II
1330 IF X>=320 OR Y>=200 THEN 1390
1340 BYTE=8192+Y*40+INT(X/8)
1350 BIT=7-(X AND 7)
1360 POKE BYTE,PEEK(BYTE) OR (2^BIT)
1370 NEXT II
1380 PRINT ".";
1390 NEXT I
1400 PRINT
1410 PRINT "DIAGONALS COMPLETE!"
1420 PRINT "PRESS ANY KEY...";
1430 GET K$:IF K$="" THEN 1430
1440 GOTO 190
1450 REM
1460 REM *** DRAW CHECKERBOARD ***
1470 REM
1480 PRINT CHR$(147)
1490 PRINT "DRAWING CHECKERBOARD..."
1500 PRINT
1510 REM DRAW IN CENTER AREA
1520 FOR Y=50 TO 149 STEP 10
1530 FOR YY=0 TO 9
1540 FOR X=10 TO 29
1550 REM ALTERNATE PATTERN
1560 IF ((Y+YY) AND 8)=(X AND 8) THEN V=255 ELSE V=0
1570 POKE 8192+(Y+YY)*40+X,V
1580 NEXT X
1590 NEXT YY
1600 PRINT ".";
1610 NEXT Y
1620 PRINT
1630 PRINT "CHECKERBOARD COMPLETE!"
1640 PRINT "PRESS ANY KEY...";
1650 GET K$:IF K$="" THEN 1650
1660 GOTO 190
1670 REM
1680 REM *** ENABLE SPRITE 0 ***
1690 REM
1700 PRINT CHR$(147)
1710 PRINT "ENABLING SPRITE 0..."
1720 PRINT
1730 REM SPRITE DATA AT $3000
1740 REM SPRITE POINTER = 12288/64 = 192
1750 POKE 2040,192
1760 PRINT "SPRITE POINTER SET"
1770 REM CREATE BALL SPRITE
1780 PRINT "CREATING BALL SPRITE..."
1790 FOR I=0 TO 62
1800 POKE 12288+I,0
1810 NEXT I
1820 REM DRAW BALL
1830 DATA 0,60,0,0,126,0,1,255,128
1840 DATA 3,255,192,7,255,224,15,255,240
1850 DATA 15,255,240,31,255,248,31,255,248
1860 DATA 31,255,248,31,255,248,31,255,248
1870 DATA 15,255,240,15,255,240,7,255,224
1880 DATA 3,255,192,1,255,128,0,126,0,0,60,0
1890 FOR I=0 TO 20
1900 FOR J=0 TO 2
1910 READ V
1920 POKE 12288+I*3+J,V
1930 NEXT J
1940 NEXT I
1950 PRINT "BALL SPRITE CREATED"
1960 REM SET SPRITE COLOR (WHITE)
1970 POKE 53287,1
1980 PRINT "SPRITE COLOR SET"
1990 REM SET SPRITE POSITION
2000 POKE 53248,160:REM X
2010 POKE 53249,100:REM Y
2020 PRINT "SPRITE POSITION SET"
2030 REM ENABLE SPRITE 0
2040 POKE 53269,1
2050 PRINT "SPRITE 0 ENABLED!"
2060 PRINT
2070 PRINT "PRESS ANY KEY...";
2080 GET K$:IF K$="" THEN 2080
2090 GOTO 190
2100 REM
2110 REM *** ANIMATE SPRITE ***
2120 REM
2130 PRINT CHR$(147)
2140 PRINT "ANIMATING SPRITE..."
2150 PRINT "PRESS ANY KEY TO STOP"
2160 PRINT
2170 X=50:Y=100:DX=2:DY=1
2180 REM ANIMATION LOOP
2190 X=X+DX
2200 IF X>280 OR X<24 THEN DX=-DX
2210 Y=Y+DY
2220 IF Y>220 OR Y<50 THEN DY=-DY
2230 POKE 53248,X
2240 POKE 53249,Y
2250 REM SMALL DELAY
2260 FOR D=1 TO 50:NEXT D
2270 REM CHECK FOR KEY
2280 GET K$:IF K$="" THEN 2190
2290 GOTO 190
2300 REM
2310 REM *** DISABLE BITMAP MODE ***
2320 REM
2330 PRINT CHR$(147)
2340 PRINT "DISABLING BITMAP MODE..."
2350 POKE 53265,PEEK(53265) AND 223
2360 POKE 53269,0:REM DISABLE SPRITES
2370 PRINT "DONE!"
2380 PRINT
2390 PRINT "PRESS ANY KEY...";
2400 GET K$:IF K$="" THEN 2400
2410 GOTO 190
2420 REM
2800 REM *** QUIT ***
2810 REM
2820 PRINT CHR$(147)
2830 PRINT "THANKS FOR TESTING!"
2840 PRINT
2850 PRINT "GRAPHICS FEATURES:"
2860 PRINT "- BITMAP MODE"
2870 PRINT "- BORDER DRAWING"
2880 PRINT "- DIAGONALS"
2890 PRINT "- CHECKERBOARD"
2900 PRINT "- ANIMATED SPRITE"
2910 END
