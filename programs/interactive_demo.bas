10 REM ********************************
20 REM * INTERACTIVE GRAPHICS DEMO    *
30 REM * BY COPILOT FOR C64PY         *
40 REM ********************************
50 REM
60 PRINT CHR$(147):REM CLEAR SCREEN
70 PRINT "C64 GRAPHICS MODE TESTER"
80 PRINT "========================"
90 PRINT
100 PRINT "THIS DEMO LETS YOU TEST"
110 PRINT "DIFFERENT GRAPHICS FEATURES"
120 PRINT "ONE AT A TIME."
130 PRINT
140 PRINT "PRESS ANY KEY TO START..."
150 GET K$:IF K$="" THEN 150
160 REM
170 REM *** MAIN MENU ***
180 REM
190 PRINT CHR$(147)
200 PRINT "GRAPHICS MODE MENU"
210 PRINT "=================="
220 PRINT
230 PRINT "1. ENABLE BITMAP MODE"
240 PRINT "2. CLEAR BITMAP"
250 PRINT "3. DRAW BORDER BOX"
260 PRINT "4. DRAW DIAGONAL LINES"
270 PRINT "5. DRAW CHECKERBOARD"
280 PRINT "6. ENABLE SPRITE 0"
290 PRINT "7. ANIMATE SPRITE"
300 PRINT "8. DISABLE BITMAP MODE"
310 PRINT "9. QUIT"
320 PRINT
330 PRINT "CHOICE (1-9)? ";
340 GET K$:IF K$="" THEN 340
350 IF K$<"1" OR K$>"9" THEN 340
360 C=VAL(K$)
370 ON C GOTO 400,500,600,700,800,900,1000,1100,1200
380 GOTO 190
390 REM
400 REM *** ENABLE BITMAP MODE ***
410 REM
420 PRINT CHR$(147)
430 PRINT "ENABLING BITMAP MODE..."
440 PRINT
450 REM SET COLORS
460 POKE 53280,0:REM BORDER=BLACK
470 POKE 53281,6:REM BACKGROUND=BLUE
480 REM ENABLE BITMAP MODE (BIT 5 OF $D011)
490 POKE 53265,PEEK(53265) OR 32
500 REM SET BITMAP AT $2000, SCREEN AT $0400
510 REM $D018: BITS 7-4=VM (SCREEN/1024), BITS 3-1=CB (CHAR/2048)
520 REM FOR SCREEN AT $0400: VM=1, FOR BITMAP AT $2000: CB=4
530 REM $D018 = %0001 1000 = $18
540 POKE 53272,24
550 PRINT "BITMAP MODE ENABLED"
560 PRINT "$D011 = ";PEEK(53265)
570 PRINT "$D018 = ";PEEK(53272)
580 PRINT
590 PRINT "PRESS ANY KEY...";
600 GET K$:IF K$="" THEN 600
610 GOTO 190
620 REM
700 REM *** CLEAR BITMAP ***
710 REM
720 PRINT CHR$(147)
730 PRINT "CLEARING BITMAP..."
740 FOR I=8192 TO 16191
750 POKE I,0
760 IF I MOD 1000 = 0 THEN PRINT ".";
770 NEXT I
780 PRINT
790 PRINT "DONE!"
800 PRINT "PRESS ANY KEY...";
810 GET K$:IF K$="" THEN 810
820 GOTO 190
830 REM
900 REM *** SET SCREEN COLORS ***
910 REM
920 PRINT CHR$(147)
930 PRINT "SETTING SCREEN COLORS..."
940 REM YELLOW (7) ON BLUE (6) = $76
950 FOR I=1024 TO 2023
960 POKE I,118
970 IF I MOD 200 = 0 THEN PRINT ".";
980 NEXT I
990 PRINT
1000 PRINT "DONE!"
1010 PRINT "PRESS ANY KEY...";
1020 GET K$:IF K$="" THEN 1020
1030 GOTO 190
1040 REM
1100 REM *** DRAW BORDER BOX ***
1110 REM
1120 PRINT CHR$(147)
1130 PRINT "DRAWING BORDER BOX..."
1140 PRINT
1150 REM TOP LINE (FIRST 40 BYTES)
1160 FOR I=0 TO 39
1170 POKE 8192+I,255
1180 NEXT I
1190 PRINT "TOP LINE DRAWN"
1200 REM BOTTOM LINE
1210 FOR I=0 TO 39
1220 POKE 8192+7960+I,255
1230 NEXT I
1240 PRINT "BOTTOM LINE DRAWN"
1250 REM LEFT AND RIGHT EDGES
1260 FOR Y=0 TO 199
1270 POKE 8192+Y*40,128:REM LEFT PIXEL
1280 POKE 8192+Y*40+39,1:REM RIGHT PIXEL
1290 IF Y MOD 50 = 0 THEN PRINT ".";
1300 NEXT Y
1310 PRINT
1320 PRINT "BORDER BOX COMPLETE!"
1330 PRINT "PRESS ANY KEY...";
1340 GET K$:IF K$="" THEN 1340
1350 GOTO 190
1360 REM
1400 REM *** DRAW DIAGONAL LINES ***
1410 REM
1420 PRINT CHR$(147)
1430 PRINT "DRAWING DIAGONALS..."
1440 PRINT
1450 REM DIAGONAL 1: TOP-LEFT TO BOTTOM-RIGHT
1460 FOR I=0 TO 100
1470 X=I*2:Y=I
1480 IF X>=320 OR Y>=200 THEN NEXT I:GOTO 1550
1490 BYTE=8192+Y*40+INT(X/8)
1500 BIT=7-(X AND 7)
1510 POKE BYTE,PEEK(BYTE) OR (2^BIT)
1520 IF I MOD 20 = 0 THEN PRINT ".";
1530 NEXT I
1540 PRINT
1550 REM DIAGONAL 2: TOP-RIGHT TO BOTTOM-LEFT
1560 FOR I=0 TO 100
1570 X=319-I*2:Y=I
1580 IF X<0 OR Y>=200 THEN NEXT I:GOTO 1650
1590 BYTE=8192+Y*40+INT(X/8)
1600 BIT=7-(X AND 7)
1610 POKE BYTE,PEEK(BYTE) OR (2^BIT)
1620 IF I MOD 20 = 0 THEN PRINT ".";
1630 NEXT I
1640 PRINT
1650 PRINT "DIAGONALS COMPLETE!"
1660 PRINT "PRESS ANY KEY...";
1670 GET K$:IF K$="" THEN 1670
1680 GOTO 190
1690 REM
1700 REM *** DRAW CHECKERBOARD ***
1710 REM
1720 PRINT CHR$(147)
1730 PRINT "DRAWING CHECKERBOARD..."
1740 PRINT
1750 REM DRAW IN CENTER AREA
1760 FOR Y=50 TO 149
1770 FOR X=10 TO 29
1780 REM ALTERNATE PATTERN
1790 IF (Y AND 8)=(X AND 8) THEN V=255 ELSE V=0
1800 POKE 8192+Y*40+X,V
1810 NEXT X
1820 IF Y MOD 25 = 0 THEN PRINT ".";
1830 NEXT Y
1840 PRINT
1850 PRINT "CHECKERBOARD COMPLETE!"
1860 PRINT "PRESS ANY KEY...";
1870 GET K$:IF K$="" THEN 1870
1880 GOTO 190
1890 REM
1900 REM *** ENABLE SPRITE 0 ***
1910 REM
1920 PRINT CHR$(147)
1930 PRINT "ENABLING SPRITE 0..."
1940 PRINT
1950 REM SPRITE DATA GOES IN SEPARATE AREA
1960 REM USE $3000 (DECIMAL 12288) FOR SPRITE DATA
1970 REM SPRITE POINTER = 12288/64 = 192 = $C0
1980 POKE 2040,192:REM SPRITE 0 POINTER
1990 PRINT "SPRITE POINTER SET TO 192"
2000 REM CREATE SIMPLE BALL SPRITE
2010 PRINT "CREATING BALL SPRITE..."
2020 FOR I=0 TO 62
2030 POKE 12288+I,0
2040 NEXT I
2050 REM DRAW BALL (SIMPLE CIRCLE)
2060 DATA 0,60,0,0,126,0,1,255,128
2070 DATA 3,255,192,7,255,224,15,255,240
2080 DATA 15,255,240,31,255,248,31,255,248
2090 DATA 31,255,248,31,255,248,31,255,248
2100 DATA 15,255,240,15,255,240,7,255,224
2110 DATA 3,255,192,1,255,128,0,126,0,0,60,0
2120 FOR I=0 TO 20
2130 FOR J=0 TO 2
2140 READ V
2150 POKE 12288+I*3+J,V
2160 NEXT J
2170 NEXT I
2180 PRINT "BALL SPRITE CREATED"
2190 REM SET SPRITE COLOR (WHITE)
2200 POKE 53287,1
2210 PRINT "SPRITE COLOR SET TO WHITE"
2220 REM SET SPRITE POSITION
2230 POKE 53248,160:REM X=160
2240 POKE 53249,100:REM Y=100
2250 PRINT "SPRITE POSITION: X=160, Y=100"
2260 REM ENABLE SPRITE 0
2270 POKE 53269,1
2280 PRINT "SPRITE 0 ENABLED!"
2290 PRINT
2300 PRINT "PRESS ANY KEY...";
2310 GET K$:IF K$="" THEN 2310
2320 GOTO 190
2330 REM
2400 REM *** ANIMATE SPRITE ***
2410 REM
2420 PRINT CHR$(147)
2430 PRINT "ANIMATING SPRITE..."
2440 PRINT "PRESS ANY KEY TO STOP"
2450 PRINT
2460 X=50:Y=100:DX=2:DY=1
2470 REM ANIMATION LOOP
2480 X=X+DX
2490 IF X>280 OR X<24 THEN DX=-DX
2500 Y=Y+DY
2510 IF Y>220 OR Y<50 THEN DY=-DY
2520 POKE 53248,X
2530 POKE 53249,Y
2540 REM SMALL DELAY
2550 FOR D=1 TO 50:NEXT D
2560 REM CHECK FOR KEY
2570 GET K$:IF K$="" THEN 2480
2580 GOTO 190
2590 REM
2600 REM *** DISABLE BITMAP MODE ***
2610 REM
2620 PRINT CHR$(147)
2630 PRINT "DISABLING BITMAP MODE..."
2640 POKE 53265,PEEK(53265) AND 223
2650 POKE 53269,0:REM DISABLE SPRITES
2660 PRINT "DONE!"
2670 PRINT
2680 PRINT "PRESS ANY KEY...";
2690 GET K$:IF K$="" THEN 2690
2700 GOTO 190
2710 REM
2800 REM *** QUIT ***
2810 REM
2820 PRINT CHR$(147)
2830 PRINT "THANKS FOR TESTING!"
2840 PRINT
2850 PRINT "GRAPHICS FEATURES:"
2860 PRINT "- BITMAP MODE"
2870 PRINT "- BORDER DRAWING"
2880 PRINT "- DIAGONALS"
2890 PRINT "- CHECKERBOARD"
2900 PRINT "- ANIMATED SPRITE"
2910 END
