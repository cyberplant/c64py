# Dockerfile for C64py with PyPy (JIT-compiled Python)
#
# Note: the PyO3 Rust core (c64py_rust_core) targets CPython only. This image
# builds reSID and runs benchmarks with --no-config --vic-emulation fast.
FROM pypy:3.10-slim

WORKDIR /app

# SDL dev libs for pygame-ce; build tools + VICE-style reSID source build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    git \
    autoconf \
    automake \
    libtool \
    libsdl2-dev libsdl2-image-dev libsdl2-mixer-dev libsdl2-ttf-dev \
    libportmidi-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching (omit maturin — PyO3 core is CPython-only)
COPY requirements.txt .
RUN grep -v '^maturin' requirements.txt > /tmp/requirements-pypy.txt \
    && pip install --no-cache-dir -r /tmp/requirements-pypy.txt

# Copy the rest of the application
COPY . .

RUN git clone --depth 1 https://github.com/cyberplant/resid.git /tmp/resid \
    && cd /tmp/resid \
    && autoreconf -i \
    && ./configure CXXFLAGS="-fPIC -g -Wall -O3 -fno-exceptions" \
    && make -j"$(nproc)" \
    && make -C /app/src/resid_wrapper RESID_SRCDIR=/tmp/resid install \
    && rm -rf /tmp/resid

# Install the package in development mode
RUN pip install -e .

RUN pypy3 -c "import pathlib; assert pathlib.Path('resid_c.so').is_file()"

# ROMs must be mounted at /roms or set via C64PY_ROM_DIR
ENV C64PY_ROM_DIR=/roms

ENTRYPOINT ["pypy3", "C64.py"]
CMD ["--benchmark", "--no-config", "--vic-emulation", "fast"]
